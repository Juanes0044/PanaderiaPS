@model List<Panaderia.web.Data.Entities.Product>




@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<a asp-action="Create" class="btn btn-primary mb-3 mt-3">Agregar Producto</a>

<table class="table table-bordered">
    
    <thead>
        <th>Nombre</th>
        <th>Precio</th>         
        <th>Stock</th>
     
    </thead>



    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.stock</td>
                <td>
                    <a asp-action="GetOne" asp-route-id="@product.Id" class="btn btn-warning">Editar</a>
                    
                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-dager">Borrar</button>
                    </form>
                </td>
            </tr>
        }
        

    </tbody> 

  

    <tfoot>
        <th>Nombre  </th>   
        <th>Precio</th>
        <th>Stock</th>
    </tfoot>

</table>